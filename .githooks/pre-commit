#!/bin/zsh
# Before each commit: quick check (scripts/check.sh --staged).
# If the commit's content has just passed the full check (scripts/ship.sh), it does not repeat it.
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ -f .build/check-passed ] && [ "$(cat .build/check-passed)" = "$(git write-tree)" ]; then
    exit 0
fi
exec ./scripts/check.sh --staged
